VITE_API_GATEWAY_URL=http://localhost:8000
VITE_ENABLE_MOCK_FALLBACK=true

# Keycloak config cho Social Login
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cgv-realm
VITE_KEYCLOAK_CLIENT_ID=CGV_App

# OTP config - khớp với backend Redis TTL
VITE_OTP_EXPIRY_SECONDS=300
VITE_OTP_RESEND_COOLDOWN=30