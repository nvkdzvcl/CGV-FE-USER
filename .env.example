# ==============================================================================
# CGV USER FRONTEND - EXAMPLE ENVIRONMENT VARIABLES
# Hướng dẫn cấu hình:
# - Chạy môi trường Local: copy thành file .env.development (hoặc .env.local)
# - Chạy môi trường Production: copy thành file .env.production
# ==============================================================================

# API Gateway URL (Kong hoặc Local Gateway)
# Local: http://localhost:8000
# Prod : http://k8s-cgvprod-kongprox-b0dc6588ff-c408e1f3fa455726.elb.ap-southeast-1.amazonaws.com
VITE_API_GATEWAY_URL=http://localhost:8000

# Realtime WebSocket URL (Ghế realtime)
# Local: ws://localhost:8000/api/v1/ws/seats
# Prod : ws://k8s-cgvprod-kongprox-b0dc6588ff-c408e1f3fa455726.elb.ap-southeast-1.amazonaws.com/api/v1/ws/seats
VITE_WS_URL=ws://localhost:8000/api/v1/ws/seats

# Keycloak Configuration
# Local: http://localhost:8180
# Prod : http://k8s-cgvprod-kongprox-b0dc6588ff-c408e1f3fa455726.elb.ap-southeast-1.amazonaws.com
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cgv-realm
VITE_KEYCLOAK_CLIENT_ID=CGV_App

# OTP Configuration (Thời gian hiệu lực OTP và cooldown gửi lại tính bằng giây)
VITE_OTP_EXPIRY_SECONDS=300
VITE_OTP_RESEND_COOLDOWN=30

# Mock fallback khi service backend chưa bật (true: fallback mock, false: 100% backend thật)
VITE_ENABLE_MOCK_FALLBACK=false
